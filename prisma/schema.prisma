generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tenant = cliente. Um cliente pode ter vários agentes e vários usuários.
model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents      Agent[]
  memberships Membership[]
  invites     Invite[]
}

// Usuário do painel. Pode ser admin (global) e/ou membro de um ou mais tenants.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  createdInvites  Invite[]     @relation("InviteCreator")
}

// Convite para criar conta no painel. O token fica em texto (prototipo):
// admin precisa ver o link para copiar, já que não há SMTP.
model Invite {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  isAdmin    Boolean   @default(false)
  tenantId   String?
  createdBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  creator User    @relation("InviteCreator", fields: [createdBy], references: [id])

  @@index([email])
}

// Vínculo usuário <-> tenant (role client, com possibilidade de escopo futuro).
model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model Agent {
  id              String    @id @default(cuid())
  agentId         String    @unique
  name            String
  tenantId        String
  persona         String?
  status          String    @default("offline")
  model           String?
  lastHeartbeatAt DateTime?
  lastVersion     String?
  heartbeatSecret String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]
}

// Evento append-only de uso de LLM. Cada chamada do agente pode gerar
// um ou mais events. Usado para agregações no painel de custos.
model UsageEvent {
  id           String   @id @default(cuid())
  agentId      String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([agentId, occurredAt])
}

// Log de todas as alterações significativas feitas via painel.
// actor* são snapshots: mantemos mesmo se o usuário for removido.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
